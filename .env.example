# Leave everything empty to run fully offline with the heuristic judge.

# --- OpenAI (enables the real LLM-as-a-judge) ---
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o-mini

# --- Judge selection: heuristic | llm | strands ---
#   heuristic: deterministic lexical estimate, no API key
#   llm:       Vercel AI SDK generateObject (requires OPENAI_API_KEY)
#   strands:   Strands Agents judge (requires OPENAI_API_KEY)
# When unset, it defaults to "llm" if OPENAI_API_KEY is present, else "heuristic".
RAG_EVAL_JUDGE=

# --- Langfuse (enables tracing and score ingestion) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
