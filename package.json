{
  "name": "rag-eval-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluation studio for RAG: RAGAS-style metrics (faithfulness, answer relevancy, context precision/recall, groundedness) computed with an LLM-as-a-judge, with a deterministic offline fallback. Vercel AI SDK, Strands Agents and Langfuse.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.65",
    "@langfuse/client": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@langfuse/vercel-ai-sdk": "^5.11.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@strands-agents/sdk": "^1.17.0",
    "ai": "^7.0.97",
    "next": "16.3.4",
    "openai": "^6.45.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
